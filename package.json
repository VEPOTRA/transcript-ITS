{
  "name": "transcript-management-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "courses:import": "tsx scripts/import-courses.ts",
    "courses:import:dry": "tsx scripts/import-courses.ts --dry-run",
    "programmes:import": "tsx scripts/import-programmes.ts",
    "programmes:import:dry": "tsx scripts/import-programmes.ts --dry-run",
    "campuses:seed": "tsx scripts/seed-campuses.ts",
    "students:import": "tsx scripts/import-students.ts",
    "students:import:dry": "tsx scripts/import-students.ts --dry-run"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.9.0",
    "next": "^15.0.0",
    "postgres": "^3.4.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0",
    "nodemailer": "^6.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^13.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "@types/nodemailer": "^6.4.0"
  }
}
